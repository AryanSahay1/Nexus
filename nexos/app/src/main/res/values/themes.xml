<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.NexOS" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nexos_background</item>
        <item name="android:statusBarColor">@color/nexos_background</item>
        <item name="android:navigationBarColor">@color/nexos_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>

    <style name="Theme.NexOS.Splash" parent="Theme.NexOS">
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/nexos_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@drawable/ic_nexos_logo</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="s">400</item>
    </style>
</resources>

# Project Nexus — environment template
#
# Real keys MUST NEVER be committed. Nexus is local-first: every user
# credential lives on-device in expo-secure-store. The values below are
# build-time public configuration only.

# ── Google OAuth client ID ─────────────────────────────────────────────────
# This is the OAuth 2.0 Client ID created in Google Cloud Console.
# It identifies the *app* to Google, not the user. PKCE means there's no
# secret to keep alongside it. See docs/GOOGLE_SETUP.md for the 10-minute
# free setup walk-through.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# ── AI provider configuration ──────────────────────────────────────────────
# These three values are sane defaults; the user can change them in the
# in-app Settings screen at runtime, which writes to user_preferences.

# Option A — OpenAI (default)
EXPO_PUBLIC_OPENAI_BASE_URL=https://api.openai.com/v1
EXPO_PUBLIC_OPENAI_MODEL=gpt-4o-mini

# Option B — Groq (free, fast)
# EXPO_PUBLIC_OPENAI_BASE_URL=https://api.groq.com/openai/v1
# EXPO_PUBLIC_OPENAI_MODEL=llama3-8b-8192

# Option C — any OpenAI-compatible endpoint, including local Ollama:
# EXPO_PUBLIC_OPENAI_BASE_URL=http://localhost:11434/v1

# ── App metadata ───────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_LOG_LEVEL=info

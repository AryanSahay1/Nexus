# Project Nexus — environment template
#
# This file documents required configuration. Real keys MUST NEVER be committed.
# Nexus is local-first: all user keys are stored on-device via expo-secure-store.
# These env vars are only for build-time, public, non-secret values.

# ---- Public OAuth client identifiers (NOT secrets) ----
# The Google OAuth client ID is provided by the user at runtime through the Vault screen.
# This example value is for local development convenience only.
EXPO_PUBLIC_DEFAULT_GOOGLE_CLIENT_ID=

# ---- App configuration ----
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_LOG_LEVEL=info
